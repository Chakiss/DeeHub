# Copy to .env for local development. Values here match infrastructure/docker-compose.yml.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# PostgreSQL
DATABASE_URL=postgresql://deehub:deehub@localhost:15432/deehub

# Redis (BullMQ + cache)
REDIS_URL=redis://localhost:16379

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-in-every-real-environment
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-in-every-real-environment
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Channel credential encryption at rest — generate with: openssl rand -base64 32
CREDENTIALS_KEY=ZGV2LW9ubHkta2V5LW5vdC1mb3ItcHJvZHVjdGlvbiE=

# S3-compatible storage (MinIO locally, GCS in production)
STORAGE_ENDPOINT=http://localhost:19000
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=deehub-local
STORAGE_ACCESS_KEY=deehub
STORAGE_SECRET_KEY=deehub-secret

# CORS — comma separated
CORS_ORIGINS=http://localhost:3000

# Where the dashboard is served, for links the API puts in an email (today just
# the password-reset link). Falls back to the first CORS origin. In production
# an unset value refuses to send rather than mail out a localhost address.
ADMIN_WEB_URL=http://localhost:3000

# Observability (optional locally)
SENTRY_DSN=

# Notification delivery (see docs/deployment.md §3). All optional: with none of
# them set, messages are composed and stored, then marked "not sent" with the
# reason, so nothing is lost and nothing pretends to have been delivered.
EMAIL_API_KEY=
EMAIL_FROM=
LINE_CHANNEL_TOKEN=
LINE_STAFF_TARGET=
