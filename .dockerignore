# Never ship these into the build context: node_modules alone is ~1GB and would
# dominate the upload, and a stale one would shadow the install inside the image.
node_modules
**/node_modules
.next
**/.next
dist
**/dist
.turbo
**/.turbo
.git
.env
.env.*
!.env.example
*.log
coverage
**/coverage
.DS_Store
